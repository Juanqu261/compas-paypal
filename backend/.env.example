# Copy to backend/.env. npm run dev, start and op:smoke load it.
# Do not commit .env or a private key. Both are gitignored.

# Authenticated Open Payments client.
# Names match the official Node snippets for createAuthenticatedClient:
#   walletAddressUrl <- CLIENT_WALLET_ADDRESS
#   keyId            <- KEY_ID
#   privateKey       <- PRIVATE_KEY_PATH
# CLIENT_WALLET_ADDRESS is COMPAS's own wallet address. It identifies the
# client and holds the developer key. Its balance is never used.
# It accepts https://... or a $payment.pointer.
# PRIVATE_KEY_PATH may be a path (relative to backend/) or the key contents.
# See https://openpayments.dev/sdk/before-you-begin/
#
# The foundation prompt illustrated prefixed names
# (OPEN_PAYMENTS_CLIENT_WALLET_ADDRESS, OPEN_PAYMENTS_KEY_ID,
# OPEN_PAYMENTS_PRIVATE_KEY_PATH). Those names are not used.
# The SDK snippets read the names below.
# If any of the three is empty, the gateway throws on every call.

CLIENT_WALLET_ADDRESS=
KEY_ID=
PRIVATE_KEY_PATH=

# Where the payer's wallet redirects after consent.
# Default: http://localhost:${PORT:-4000}/open-payments/finish
OPEN_PAYMENTS_FINISH_URI=

# Frontend page the backend sends the payer's browser to after the finish
# callback. Default: http://localhost:3000/demo
OPEN_PAYMENTS_RETURN_URL=

# demo/test data: test-network wallets for the smoke test and the demo.
# Pedro's USD wallet (payer) and Droguería Central's wallet (merchant).
# The COMPAS mandate routes also use DEMO_PAYER_WALLET_ADDRESS as Pedro's
# wallet. Without it, Pedro can draft a budget but not authorize it.
DEMO_PAYER_WALLET_ADDRESS=
DEMO_MERCHANT_WALLET_ADDRESS=
# Optional second merchant wallet: the liquor store of the alcohol scenario.
# Empty: the store uses the reserved example domain, which COMPAS can evaluate
# but Open Payments can't pay.
DEMO_LIQUOR_WALLET_ADDRESS=

# Port for the smoke test's one-off consent listener. Default: 4123
OP_SMOKE_PORT=

# Storage. Empty: every log is in memory and a restart loses it.
# Set: Supabase Postgres (schema in data/migrations/), through the pooler in
# transaction mode as the compas_api role, e.g.
# postgres://compas_api.<project-ref>:<password>@<pooler-host>:6543/postgres
# A secret. Never a NEXT_PUBLIC_* variable.
DATABASE_URL=

# Owner connection string, only for `npm run registry:load`. The backend role
# can only read the Cámara de Comercio registry.
DATABASE_ADMIN_URL=

# Merchant category service.
# Key for the HMAC that replaces a NIT in the trust log (32+ characters).
# A sole proprietor's NIT is their cédula. The same key, under another prefix,
# replaces payer and delegate ids in the merchant observation log.
# Required with DATABASE_URL: stored refs must outlive the process. Never change
# it once data is stored. Empty without a database: a random key per process.
MERCHANT_SUBJECT_HMAC_KEY=

# demo/test data: seed simulated Nequi Negocios evidence and the demo tienda's
# purchase history at startup.
# Default: on. Set to false to start with empty logs and no sources.
MERCHANT_CATEGORY_DEMO_SEED=

# DEMO IDENTITY for the mandate routes: POST /demo/sessions lets the ARQ and
# Nequi simulations act as Pedro, Andrea or Gladys. Anyone who reaches the
# backend can do it, so it is never on with NODE_ENV=production.
# Default: on. Set to disabled to turn it off (mandate routes then answer 503).
COMPAS_DEMO_IDENTITY=

# Whether a DEMO session may ask Pedro's wallet for a real Open Payments grant.
# Off by default: anyone can start a demo session as Pedro, so authorize then
# answers 403 PAYER_GRANTS_DISABLED_FOR_DEMO. Set to enabled only for a
# supervised demo with CLIENT_WALLET_ADDRESS and DEMO_PAYER_WALLET_ADDRESS on
# interledger-test.dev. Never on with NODE_ENV=production.
COMPAS_DEMO_PAYER_GRANTS=

# Whether a DEMO session may spend a payer's grant through POST /purchases.
# Off by default: anyone can start a demo session as Andrea, so POST /purchases
# then answers 403 PURCHASES_DISABLED_FOR_DEMO. POST /purchases/preview works
# either way: it writes nothing and calls no wallet. Set to enabled only for a
# supervised demo with CLIENT_WALLET_ADDRESS, DEMO_PAYER_WALLET_ADDRESS and
# DEMO_MERCHANT_WALLET_ADDRESS on interledger-test.dev. Never on with
# NODE_ENV=production. Policy still decides every purchase.
COMPAS_DEMO_PURCHASES=

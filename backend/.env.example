# Copy to backend/.env. Never commit it. Secrets are never NEXT_PUBLIC_*.
# Empty values throw at the call that needs them: nothing is faked.

# --- Needed for the demo -----------------------------------------------------

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Droguería Central's sandbox BUSINESS account merchant id (13 characters),
# not the account that owns the app. Payee of every pharmacy order.
DEMO_MERCHANT_PAYPAL_ID=
# Lets demo sessions create real sandbox orders. Pedro still approves each one.
COMPAS_DEMO_PURCHASES=enabled

# Elastic Cloud project (Elasticsearch): CUM search.
# Build the index once with: npm run cum:index -- --demo
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Claude API key (platform.claude.com): the analyst's and errand drafter's model.
# Empty: the model is Elastic's Inference API instead.
ANTHROPIC_API_KEY=

# --- Optional ----------------------------------------------------------------
# Uncomment only what you need. Everything else has a working default.

# The DEMO_MERCHANT_PAYPAL_ID account's email: lets Log in with PayPal bind the
# Cámara certificate (EXTERNAL_VERIFIED). Empty: the certificate never binds.
# DEMO_MERCHANT_PAYPAL_EMAIL=
# Token for POST /operator/findings/:id/withdraw. Empty: that route answers 503.
# COMPAS_OPERATOR_TOKEN=
# The Claude model. Default: claude-haiku-5-5
# ANTHROPIC_ANALYST_MODEL=
# Without ANTHROPIC_API_KEY: the Elastic chat_completion endpoint to use.
# ELASTIC_ANALYST_INFERENCE_ID=
# A text_embedding endpoint for semantic CUM search. Set before cum:index.
# ELASTIC_CUM_EMBEDDING_INFERENCE_ID=
# "demo": verify CUMs against data/seeds/cum instead of datos.gov.co (offline).
# CUM_REGISTRY=demo

# More sandbox accounts: the liquor store's merchant id, and Pedro's payer id
# (with it, only that account's approvals are captured).
# DEMO_LIQUOR_PAYPAL_ID=
# DEMO_PAYER_PAYPAL_ID=

# Supabase Postgres (compas_api role, pooler, port 6543). Empty: in memory.
# With it, MERCHANT_SUBJECT_HMAC_KEY (32+ chars) is required and never changes.
# DATABASE_URL=
# MERCHANT_SUBJECT_HMAC_KEY=
# DATABASE_ADMIN_URL=   (owner role: npm run registry:load and applying migrations)

# AI agents over MCP (ADR 0011). Where MCP clients reach this server, and the
# frontend screen where a delegate answers an agent's request (?request=… is added).
# COMPAS_PUBLIC_URL=http://localhost:4000
# COMPAS_AGENT_CONSENT_URL=http://localhost:3000/agents/authorize
# Browser origins allowed to call /mcp, comma-separated. Clients with no Origin are fine.
# COMPAS_MCP_ALLOWED_ORIGINS=

# Defaults you rarely change:
# PORT=4000
# LOG_LEVEL=info                        (debug also shows polled GETs and Elastic calls; warn, error, silent)
# PAYPAL_ENVIRONMENT=sandbox             (the only value accepted)
# PAYPAL_RETURN_URI / PAYPAL_CANCEL_URI  (http://localhost:4000/paypal/orders/return, /cancel)
# PAYPAL_FRONTEND_RETURN_URL             (http://localhost:3000/demo)
# PAYPAL_IDENTITY_RETURN_URI             (http://localhost:4000/paypal/identity/return)
# PAYPAL_IDENTITY_FRONTEND_RETURN_URL    (http://localhost:3000/paypal-business)
# PAYPAL_SMOKE_PORT=4123
# ELASTIC_CUM_INDEX=compas-cum-v1
# SOCRATA_APP_TOKEN=                     (datos.gov.co works without it)
# MERCHANT_CATEGORY_DEMO_SEED=false      (start with no demo evidence)
# COMPAS_DEMO_IDENTITY=disabled          (turn off demo sessions)
# COMPAS_ANALYST_JOBS=disabled           (turn off POST /analyst/jobs)
# COMPAS_TRUST_FORWARDED_FOR=true        (behind a proxy: limit new demos per X-Forwarded-For address)

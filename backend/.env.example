# Copy to backend/.env. npm run dev, start, paypal:smoke and compas:smoke load it.
# Do not commit .env. It is gitignored.

# PayPal REST app, from https://developer.paypal.com/dashboard/applications/sandbox
# Both are secrets. Never NEXT_PUBLIC_* variables.
# If either is empty, every PayPal call throws: nothing is faked.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# COMPAS runs on the PayPal sandbox only (https://api-m.sandbox.paypal.com).
# Empty or "sandbox". Any other value stops the backend at startup.
PAYPAL_ENVIRONMENT=

# Where PayPal sends the payer's browser after approving or cancelling an
# order. The backend serves both, captures an approved order there, then
# redirects to PAYPAL_FRONTEND_RETURN_URL.
# Defaults: http://localhost:${PORT:-4000}/paypal/orders/return and /cancel
PAYPAL_RETURN_URI=
PAYPAL_CANCEL_URI=

# Frontend page the backend sends the payer's browser to after PayPal.
# Default: http://localhost:3000/demo
PAYPAL_FRONTEND_RETURN_URL=

# demo/test data: PayPal sandbox accounts for the demo, from
# https://developer.paypal.com/dashboard/accounts (account details).
#
# Droguería Central's sandbox BUSINESS account: its merchant id (13
# characters, for example JYHT3DF634TAG). It is the payee of every pharmacy
# order. Use a business account other than the one that owns the app above,
# or COMPAS's own account would receive the money.
# Empty: the pharmacy uses a demo id that PayPal refuses as a payee.
DEMO_MERCHANT_PAYPAL_ID=
# Optional: a second sandbox business account for the liquor store.
DEMO_LIQUOR_PAYPAL_ID=
# Optional: Pedro's sandbox PERSONAL account's payer id. With it, COMPAS
# captures only orders that account approved. Empty: whoever approves pays.
DEMO_PAYER_PAYPAL_ID=

# Port for the smoke tests' one-off return listener. Default: 4123
PAYPAL_SMOKE_PORT=

# Storage. Empty: every log is in memory and a restart loses it.
# Set: Supabase Postgres (schema in data/migrations/), through the pooler in
# transaction mode as the compas_api role, e.g.
# postgres://compas_api.<project-ref>:<password>@<pooler-host>:6543/postgres
# A secret. Never a NEXT_PUBLIC_* variable.
DATABASE_URL=

# Owner connection string, only for `npm run registry:load`. The backend role
# can only read the Cámara de Comercio registry.
DATABASE_ADMIN_URL=

# Merchant category service.
# Key for the HMAC that replaces a NIT in the trust log (32+ characters).
# A sole proprietor's NIT is their cédula. The same key, under another prefix,
# replaces payer and delegate ids in the merchant observation log.
# Required with DATABASE_URL: stored refs must outlive the process. Never change
# it once data is stored. Empty without a database: a random key per process.
MERCHANT_SUBJECT_HMAC_KEY=

# demo/test data: seed simulated Nequi Negocios evidence and the demo tienda's
# purchase history at startup.
# Default: on. Set to false to start with empty logs and no sources.
MERCHANT_CATEGORY_DEMO_SEED=

# DEMO IDENTITY for the mandate routes: POST /demo/sessions lets the ARQ and
# Nequi simulations act as Pedro, Andrea or Gladys. Anyone who reaches the
# backend can do it, so it is never on with NODE_ENV=production.
# Default: on. Set to disabled to turn it off (mandate routes then answer 503).
COMPAS_DEMO_IDENTITY=

# Whether a DEMO session may create PayPal orders through POST /purchases.
# Off by default: anyone can start a demo session as Andrea, so POST
# /purchases then answers 403 PURCHASES_DISABLED_FOR_DEMO. POST
# /purchases/preview works either way: it writes nothing and calls no PayPal
# API. Set to enabled only for a supervised sandbox demo, with
# DEMO_MERCHANT_PAYPAL_ID set. Never on with NODE_ENV=production. Policy still
# decides every purchase, and Pedro still approves every order at PayPal.
COMPAS_DEMO_PURCHASES=

{
  "name": "compas-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --env-file-if-exists=.env --watch src/api/server.ts",
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/api/server.ts",
    "op:smoke": "node --experimental-strip-types --env-file-if-exists=.env scripts/op-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "dependencies": {
    "@interledger/open-payments": "7.4.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}

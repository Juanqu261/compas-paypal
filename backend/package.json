{
  "name": "compas-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --env-file-if-exists=.env --watch src/api/server.ts",
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/api/server.ts",
    "paypal:smoke": "node --experimental-strip-types --env-file-if-exists=.env scripts/paypal-smoke.ts",
    "paypal:visitor-smoke": "node --experimental-strip-types --env-file-if-exists=.env scripts/visitor-accounts-smoke.ts",
    "compas:smoke": "node --experimental-strip-types --env-file-if-exists=.env scripts/compas-smoke.ts",
    "registry:fetch": "node --experimental-strip-types scripts/fetch-rues-registry.ts",
    "registry:load": "node --experimental-strip-types --env-file-if-exists=.env scripts/load-rues-registry.ts",
    "cum:index": "node --experimental-strip-types --env-file-if-exists=.env scripts/index-cum.ts",
    "analyst:smoke": "node --experimental-strip-types --env-file-if-exists=.env scripts/analyst-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "postgres": "3.4.9"
  },
  "engines": {
    "node": ">=22.9"
  }
}

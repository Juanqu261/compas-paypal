# The COMPAS backend that /compas-api/* proxies to. Server-side only.
COMPAS_BACKEND_URL=http://localhost:4000

# Evidence links in Act 1 of /demo, for a presenter logged in to those consoles.
# Public URLs, not secrets. A link whose variable is empty is not shown.
# Kibana of the Elastic project, without a trailing slash.
NEXT_PUBLIC_DEMO_KIBANA_URL=
# The CUM index built by `npm run cum:index` in backend/.
NEXT_PUBLIC_DEMO_ELASTIC_CUM_INDEX=compas-cum-v1
# The Supabase project ref: the id in supabase.com/dashboard/project/<ref>.
NEXT_PUBLIC_DEMO_SUPABASE_PROJECT_REF=
